{
  "name": "dsh-memoryleak",
  "version": "0.7.0",
  "description": "DSH MemoryLeak 插件：/ml help 查看全部命令。/ml <文本> 记一笔到日志/周志；/ml todo n 固定表单加结构化待办；/ml todo l 列待办（sleep 到日唤醒，带序号）；/ml todo d 切换完成态；/ml todo u 撤销。全程无 LLM、零 token。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./core": "./src/core/index.js",
    "./settings-schema": "./src/settings-schema.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "notes",
    "todo",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/example/dsh-memoryleak.git"
  },
  "license": "MIT"
}
